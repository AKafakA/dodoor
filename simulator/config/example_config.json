{
  "experiment": {
    "name": "dodoor_validation_experiment",
    "duration": 300,
    "warmup_duration": 30,
    "seed": 12345
  },
  "scheduler": {
    "type": "dodoor",
    "beta": 0.6,
    "batch_size": 1024,
    "packing_strategy": "score",
    "weights": {
      "cpu": 2.0,
      "memory": 1.0,
      "disk": 1.0,
      "duration": 0.5
    },
    "num_tasks_to_update": 1,
    "rif_quantile": 0.8,
    "probe_pool_size": 10,
    "delta": 1,
    "probe_rate": 2,
    "probe_delete_rate": 1,
    "probe_age_budget_ms": 10000.0
  },
  "cluster": {
    "node_types": [
      {
        "type": "m510",
        "count": 4,
        "cores": 8,
        "memory": 65536,
        "disk": 0,
        "slots": 4,
        "late_binding_enabled": false
      },
      {
        "type": "xl170", 
        "count": 2,
        "cores": 10,
        "memory": 65536,
        "disk": 0,
        "slots": 5,
        "late_binding_enabled": false
      }
    ],
    "network": {
      "mean_latency_ms": 2.0,
      "std_latency_ms": 0.5,
      "scheduler_to_node_ms": 2.0,
      "node_to_datastore_ms": 1.0,
      "scheduler_to_datastore_ms": 1.0
    }
  },
  "workload": {
    "type": "trace",
    "trace_file": "deploy/resources/configuration/generated_config/merged_profiler_config.json",
    "synthetic": {
      "arrival_rate": 10.0,
      "arrival_pattern": "poisson",
      "task_mix": {
        "float_operation": 0.4,
        "image_processing": 0.3,
        "matrix_multiply": 0.3
      }
    }
  },
  "output": {
    "metrics_file": "simulation_metrics.json",
    "log_level": "INFO",
    "enable_detailed_metrics": true,
    "metrics_interval_ms": 1000,
    "output_directory": "simulation_output"
  }
}